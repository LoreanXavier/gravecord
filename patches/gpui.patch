+/// Nanoseconds the draws of all windows spent in building and laying out the root view, in preparing to paint
+/// (layout and hit testing) and in painting, and how many draws that was. Read by the app's perf harness.
+static DRAW_PHASE_NS: [std::sync::atomic::AtomicU64; 15] = [
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+];
+
+/// Adds `ns` to the counter `slot` of the table above and counts one call in the next slot. Slots 7 and up are the
+/// per-tick counters of `tick_totals`.
+pub fn add_tick_counter(slot: usize, ns: u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    DRAW_PHASE_NS[slot].fetch_add(ns, Relaxed);
+    DRAW_PHASE_NS[slot + 1].fetch_add(1, Relaxed);
+}
+
+/// What a tick of the frame loop costs beside the draw: (request-frame closure ns, calls, next-frame callback ns,
+/// calls, sprite atlas lookup and upload ns while painting images, calls, foreground task ns, tasks).
+pub fn tick_totals() -> [u64; 8] {
+    use std::sync::atomic::Ordering::Relaxed;
+    let mut out = [0; 8];
+    for (index, slot) in out.iter_mut().enumerate() {
+        *slot = DRAW_PHASE_NS[7 + index].load(Relaxed);
+    }
+    out
+}
+
+/// Counts the time until it is dropped into the counter `slot` (7, 9, 11 or 13).
+pub struct TickTimer {
+    slot: usize,
+    started: std::time::Instant,
+}
+
+impl TickTimer {
+    /// Starts timing for the counter `slot`.
+    pub fn new(slot: usize) -> Self {
+        Self {
+            slot,
+            started: std::time::Instant::now(),
+        }
+    }
+}
+
+impl Drop for TickTimer {
+    fn drop(&mut self) {
+        add_tick_counter(self.slot, self.started.elapsed().as_nanos() as u64);
+    }
+}
+
+fn record_draw_phases(
+    start: std::time::Instant,
+    layout: std::time::Instant,
+    prepaint: std::time::Instant,
+    end: std::time::Instant,
+) {
+    use std::sync::atomic::Ordering::Relaxed;
+    DRAW_PHASE_NS[0].fetch_add((layout - start).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[1].fetch_add((prepaint - layout).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[2].fetch_add((end - prepaint).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[3].fetch_add(1, Relaxed);
+}
+
+/// A frame the window drew and presented on its own (not one a script drew): the draw, the present and the clearing
+/// after it.
+fn record_frame(start: std::time::Instant, drawn: std::time::Instant, end: std::time::Instant) {
+    use std::sync::atomic::Ordering::Relaxed;
+    DRAW_PHASE_NS[4].fetch_add((drawn - start).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[5].fetch_add((end - drawn).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[6].fetch_add(1, Relaxed);
+}
+
+/// Totals of the frames the window drew itself so far: (draw ns, present and clear ns, frames).
+pub fn frame_totals() -> (u64, u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    (
+        DRAW_PHASE_NS[4].load(Relaxed),
+        DRAW_PHASE_NS[5].load(Relaxed),
+        DRAW_PHASE_NS[6].load(Relaxed),
+    )
+}
+
+/// Totals of the draw phases so far: (request layout ns, prepaint ns, paint ns, draws).
+pub fn draw_phase_totals() -> (u64, u64, u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    (
+        DRAW_PHASE_NS[0].load(Relaxed),
+        DRAW_PHASE_NS[1].load(Relaxed),
+        DRAW_PHASE_NS[2].load(Relaxed),
+        DRAW_PHASE_NS[3].load(Relaxed),
+    )
+}
