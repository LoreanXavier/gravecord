+/// A picture an `Img` or a custom element painted: the encoded image and the decoded one the sprite atlas holds.
+pub type PaintedImage = (Arc<Image>, Arc<RenderImage>);
+
+thread_local! {
+    static PAINTED_IMAGES: std::cell::RefCell<collections::FxHashMap<u64, collections::FxHashMap<u64, PaintedImage>>> =
+        std::cell::RefCell::new(Default::default());
+}
+
+/// Records that `window` painted `image` (decoded as `data`) in the frame being drawn, for [`take_painted_images`].
+pub fn note_painted_image(window: &Window, image: &Arc<Image>, data: &Arc<RenderImage>) {
+    let window_id = window.window_handle().window_id().as_u64();
+    PAINTED_IMAGES.with(|painted| {
+        painted
+            .borrow_mut()
+            .entry(window_id)
+            .or_default()
+            .insert(image.id, (image.clone(), data.clone()));
+    });
+}
+
+/// The pictures painted since the last call, by window id (`WindowId::as_u64`). An application uses it to learn
+/// which decoded pictures are on screen and to release the ones that are not.
+pub fn take_painted_images() -> Vec<(u64, Vec<PaintedImage>)> {
+    PAINTED_IMAGES.with(|painted| {
+        std::mem::take(&mut *painted.borrow_mut())
+            .into_iter()
+            .map(|(window, images)| (window, images.into_values().collect()))
+            .collect()
+    })
+}
