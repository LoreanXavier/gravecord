+            l85 < l95 && l95 < l100 && l100 < l105 && l105 < l115,
+            "expected monotonic Gaussian ramp: {l85}, {l95}, {l100}, {l105}, {l115}"
+        );
+        assert!(
+            (110..=146).contains(&l100),
+            "expected ~50% midpoint at x=100, got {l100}"
+        );
+        assert!(
+            l115 > 215 && l115 < 255,
+            "expected upper Gaussian shoulder at x=115, got {l115}"
+        );
+
+        // 3. Above the blur region (y = 2), the black/white split remains razor-sharp.
+        assert_eq!(img.get_pixel(99, 2).0[1], 0);
+        assert_eq!(img.get_pixel(100, 2).0[1], 255);
+
+        // 4. Foreground border quad drawn after BackdropBlur remains crisp pure blue.
+        let border_px = img.get_pixel(100, 89).0;
+        assert_eq!(border_px, [0, 0, 255, 255]);
+    }
+
+    #[std::prelude::v1::test]
+    fn test_backdrop_blur_mask_clamping_and_top_fade() {
+        let Ok(devices) = DirectXDevices::new() else {
+            return;
+        };
+        let hwnd = unsafe {
+            CreateWindowExW(
+                WINDOW_EX_STYLE(0),
+                w!("STATIC"),
+                w!(""),
+                WINDOW_STYLE(0),
+                0,
+                0,
+                200,
+                160,
+                Some(HWND_MESSAGE),
+                None,
+                None,
+                None,
+            )
+        }
+        .expect("HWND_MESSAGE creation should succeed");
+
+        let mut renderer =
+            DirectXRenderer::new(hwnd, &devices, true).expect("DirectXRenderer should initialize");
+        renderer
+            .resize(size(DevicePixels(200), DevicePixels(160)))
+            .expect("resize should succeed");
+
+        let full_mask = ContentMask {
+            bounds: Bounds {
+                origin: point(ScaledPixels(0.0), ScaledPixels(0.0)),
+                size: size(ScaledPixels(200.0), ScaledPixels(160.0)),
+            },
+        };
+        let solid_quad = |x: f32, y: f32, w: f32, h: f32, color: Hsla| Quad {
+            order: 0,
+            border_style: BorderStyle::Solid,
+            bounds: Bounds {
+                origin: point(ScaledPixels(x), ScaledPixels(y)),
+                size: size(ScaledPixels(w), ScaledPixels(h)),
+            },
+            content_mask: full_mask,
+            background: color.into(),
+            border_color: transparent_black(),
+            corner_radii: Corners::default(),
+            border_widths: Edges::default(),
+        };
+
+        let mut scene = Scene::default();
+        // Poison green sidebar at x = 0..40 and poison red titlebar at y = 0..30.
+        scene.insert_primitive(solid_quad(0.0, 0.0, 40.0, 160.0, rgb(0x00ff00).into()));
+        scene.insert_primitive(solid_quad(40.0, 0.0, 160.0, 30.0, rgb(0xff0000).into()));
+        // Page area [40..200, 30..160]: left half black (40..120), right half white (120..200).
+        scene.insert_primitive(solid_quad(40.0, 30.0, 80.0, 130.0, rgb(0x000000).into()));
+        scene.insert_primitive(solid_quad(120.0, 30.0, 80.0, 130.0, rgb(0xffffff).into()));
+
+        let page_mask = ContentMask {
+            bounds: Bounds {
+                origin: point(ScaledPixels(40.0), ScaledPixels(30.0)),
+                size: size(ScaledPixels(160.0), ScaledPixels(130.0)),
+            },
+        };
+        // Blur inside page_mask with 60px top fade ramp.
+        scene.insert_primitive(BackdropBlur {
+            order: 0,
+            blur_radius: ScaledPixels(12.0),
+            bounds: Bounds {
+                origin: point(ScaledPixels(40.0), ScaledPixels(30.0)),
+                size: size(ScaledPixels(160.0), ScaledPixels(100.0)),
+            },
+            corner_radii: Corners::default(),
+            content_mask: page_mask,
+            opacity: 1.0,
+            fade_top: ScaledPixels(60.0),
+        });
+        scene.finish();
+
+        let img = renderer
+            .render_to_image(&scene, WindowBackgroundAppearance::Opaque)
+            .expect("offscreen render_to_image should succeed");
+
+        unsafe {
+            let _ = DestroyWindow(hwnd);
+        }
+
+        // 1. Inside page_mask at (41, 100), neither red titlebar nor green sidebar may bleed in.
+        let top_left_page = img.get_pixel(41, 100).0;
+        assert_eq!(
+            top_left_page[0], 0,
+            "red bled across content_mask: {top_left_page:?}"
+        );
+        assert_eq!(
+            top_left_page[1], 0,
+            "green bled across content_mask: {top_left_page:?}"
+        );
+
+        // 2. Top fade ramp at x = 115 (5px left of black/white split):
+        //    near top (y = 31) alpha ~ 0 => nearly black;
+        //    mid fade (y = 60) => intermediate gray;
+        //    past 60px fade (y = 100) => full Gaussian blur weight.
+        let top_val = img.get_pixel(115, 31).0[2];
+        let mid_val = img.get_pixel(115, 60).0[2];
+        let full_val = img.get_pixel(115, 100).0[2];
+        assert!(
+            top_val < 15,
+            "expected near-zero blur at start of fade_top, got {top_val}"
+        );
+        assert!(
+            top_val < mid_val && mid_val < full_val && full_val > 60,
+            "expected smooth vertical fade_top progression: top={top_val}, mid={mid_val}, full={full_val}"
+        );
+    }
+}
