+    /// A hash of the last rendered frame's painted scene (boxes, shadows, underlines, glyphs and icons, not pictures), for
+    /// change detection. Anything that starts above `skip_top` (the title bar) is left out.
+    pub fn scene_fingerprint(&self, skip_top: Pixels) -> u64 {
+        use std::hash::{Hash, Hasher};
+        let scene = &self.rendered_frame.scene;
+        let floor = skip_top.0 * self.scale_factor();
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        macro_rules! feed {
+            ($list:expr) => {
+                for item in $list {
+                    if item.bounds.origin.y.0 >= floor {
+                        format!("{item:?}").hash(&mut hasher);
+                    }
+                }
+            };
+        }
+        feed!(&scene.quads);
+        feed!(&scene.shadows);
+        feed!(&scene.underlines);
+        feed!(&scene.monochrome_sprites);
+        feed!(&scene.subpixel_sprites);
+        // Pictures (polychrome sprites, paths, surfaces) are left out: animated stickers and GIFs change by themselves.
+        hasher.finish()
+    }
