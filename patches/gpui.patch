+        assert_eq!(quads[0].corner_radii.top_left.0 / f, 8.);
+        // Half size about (60, 45): the quad's own centre stays put.
+        assert_eq!(rect(&quads[1]), [35., 32.5, 50., 25.]);
+        assert_eq!(quads[1].corner_radii.top_left.0 / f, 4.);
+        assert_eq!(quads[1].border_widths.top.0 / f, 1.);
+        // Nested: .5 * .5 = .25, about the window origin after the outer transform: 2.5, 5, 25, 12.5
+        // composed with the outer scale: p' = .25 p + 60 * .5 * ... (see the algebra in with_paint_scale).
+        let inner = rect(&quads[2]);
+        assert_eq!(inner[2], 25.);
+        assert_eq!(inner[3], 12.5);
+        assert_eq!(inner[0], 10. * 0.25 + 30.);
+        assert_eq!(inner[1], 20. * 0.25 + 22.5);
+        // The mask (10, 20, 40, 50) scales to (35, 32.5, 20, 25) and clips the quad's mask: its bounds at (35,
+        // 32.5, 50, 25) intersect it.
+        let mask = quads[3].content_mask.bounds;
+        assert_eq!(
+            [
+                mask.origin.x.0 / f,
+                mask.origin.y.0 / f,
+                mask.size.width.0 / f,
+                mask.size.height.0 / f
+            ],
+            [35., 32.5, 20., 25.]
+        );
+        assert_eq!(rect(&quads[4]), [10., 20., 100., 50.]);
+    }
+}
+
+impl Window {
+    /// Makes the layout tree a cached view computes next start where the view really sits in the layout it is placed
+    /// in: the unsnapped origin of the node whose bounds were asked for last, so every box of the view snaps to the
+    /// same device pixel as when the view's elements are laid out inline.
+    pub(crate) fn align_next_layout_root(
+        &mut self,
+        placed: Option<LayoutId>,
+        root: LayoutId,
+        snapped: Size<Pixels>,
+    ) -> Size<Pixels> {
+        let (Some(id), scale) = (placed, self.scale_factor()) else {
+            return snapped;
+        };
+        let Some(engine) = self.layout_engine.as_mut() else {
+            return snapped;
+        };
+        let origin = engine.raw_origin(id, scale);
+        engine.set_pending_root_origin(root, origin);
+        let size = engine.raw_size(id);
+        Size {
+            width: Pixels(size.width / scale),
+            height: Pixels(size.height / scale),
+        }
+    }
 }
