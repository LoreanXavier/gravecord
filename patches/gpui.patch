+    /// Whether some primitive of the layer covers the whole window (a scrim), and the bounds, in window pixels,
+    /// of the union of the primitives that do not (the dialog on it).
+    pub fn scrim_and_content(&self, window: &Window) -> (bool, Option<Bounds<Pixels>>) {
+        let factor = window.scale_factor();
+        let viewport = window.viewport_size().scale(factor);
+        let mut scrim = false;
+        let mut content: Option<Bounds<ScaledPixels>> = None;
+        for operation in &self.operations {
+            if let crate::scene::PaintOperation::Primitive(primitive) = operation {
+                let bounds = *primitive.bounds();
+                if bounds.size.width >= viewport.width && bounds.size.height >= viewport.height {
+                    scrim = true;
+                } else {
+                    content = Some(content.map_or(bounds, |c| c.union(&bounds)));
+                }
+            }
+        }
+        let content = content.map(|b| Bounds {
+            origin: point(Pixels(b.origin.x.0 / factor), Pixels(b.origin.y.0 / factor)),
+            size: size(
+                Pixels(b.size.width.0 / factor),
+                Pixels(b.size.height.0 / factor),
+            ),
+        });
+        (scrim, content)
+    }
