+
+/*
+**
+**              Backdrop blur
+**
+*/
+
+struct BackdropBlurInstance {
+    Bounds draw_bounds;
+    Bounds element_bounds;
+    Corners corner_radii;
+    Bounds content_mask;
+    float2 uv_min;
+    float2 uv_max;
+    float sigma;
+    float opacity;
+    float fade_top;
+    uint direction;
+};
+
+struct BackdropBlurVertexOutput {
+    nointerpolation uint instance_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+struct BackdropBlurFragmentInput {
+    nointerpolation uint instance_id: TEXCOORD0;
+    float4 position: SV_Position;
+};
+
+StructuredBuffer<BackdropBlurInstance> backdrop_blurs: register(t1);
+Texture2D<float4> t_backdrop_orig: register(t2);
+
+BackdropBlurVertexOutput backdrop_blur_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    uint idx = batch_start_index + instance_id;
+    BackdropBlurInstance blur = backdrop_blurs[idx];
+
+    BackdropBlurVertexOutput output;
+    output.position = to_device_position(unit_vertex, blur.draw_bounds);
+    output.instance_id = idx;
+    output.clip_distance = distance_from_clip_rect(unit_vertex, blur.draw_bounds, blur.content_mask);
+    return output;
+}
+
+float4 backdrop_blur_fragment(BackdropBlurFragmentInput input): SV_Target {
+    BackdropBlurInstance blur = backdrop_blurs[input.instance_id];
+    float2 inv_viewport = 1.0 / global_viewport_size;
+    float2 axis = (blur.direction == 0u) ? float2(1.0, 0.0) : float2(0.0, 1.0);
+
+    float sigma = max(blur.sigma, 0.001);
+    float inv_two_sigma_sq = 0.5 / (sigma * sigma);
+    int radius = min(int(ceil(sigma * 3.0)), 192);
+
+    float2 center_px = clamp(input.position.xy, blur.uv_min, blur.uv_max);
+    float4 acc = t_sprite.SampleLevel(s_sprite, center_px * inv_viewport, 0.0);
+    float weight_sum = 1.0;
+
+    [loop]
+    for (int k = 1; k <= radius; k += 2) {
+        float k0 = float(k);
+        float w0 = exp(-(k0 * k0) * inv_two_sigma_sq);
+        float k1 = float(k + 1);
+        float w1 = (k + 1 <= radius) ? exp(-(k1 * k1) * inv_two_sigma_sq) : 0.0;
+        float w = w0 + w1;
+        float offset = k0 + (w1 / max(w, 1e-6));
+
+        float2 pos_px = clamp(input.position.xy + axis * offset, blur.uv_min, blur.uv_max);
+        float2 neg_px = clamp(input.position.xy - axis * offset, blur.uv_min, blur.uv_max);
+
+        acc += (
+            t_sprite.SampleLevel(s_sprite, pos_px * inv_viewport, 0.0) +
+            t_sprite.SampleLevel(s_sprite, neg_px * inv_viewport, 0.0)
+        ) * w;
+        weight_sum += 2.0 * w;
+    }
+
+    float4 color = acc / weight_sum;
+    if (blur.direction == 0u) {
+        return color;
+    }
+
+    float distance = quad_sdf(input.position.xy, blur.element_bounds, blur.corner_radii);
+    float alpha = blur.opacity * saturate(0.5 - distance);
+    if (blur.fade_top > 0.0) {
+        float t = saturate((input.position.y - blur.element_bounds.origin.y) / blur.fade_top);
+        float inv_t = 1.0 - t;
+        alpha *= 1.0 - pow(inv_t, 2.2);
+    }
+    float4 unblurred = t_backdrop_orig.Load(int3(int2(input.position.xy), 0));
+    return lerp(unblurred, color, alpha);
+}
