+impl Window {
+    /// Makes the layout tree a cached view computes next start where the view really sits in the layout it is placed
+    /// in: the unsnapped origin of the node whose bounds were asked for last, so every box of the view snaps to the
+    /// same device pixel as when the view's elements are laid out inline.
+    pub(crate) fn align_next_layout_root(
+        &mut self,
+        placed: Option<LayoutId>,
+        root: LayoutId,
+        snapped: Size<Pixels>,
+    ) -> Size<Pixels> {
+        let (Some(id), scale) = (placed, self.scale_factor()) else {
+            return snapped;
+        };
+        let Some(engine) = self.layout_engine.as_mut() else {
+            return snapped;
+        };
+        let origin = engine.raw_origin(id, scale);
+        engine.set_pending_root_origin(root, origin);
+        let size = engine.raw_size(id);
+        Size {
+            width: Pixels(size.width / scale),
+            height: Pixels(size.height / scale),
+        }
+    }
 }
