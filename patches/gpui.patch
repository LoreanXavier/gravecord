+    #[gpui::test]
+    fn test_paint_scale_transforms_quads(cx: &mut TestAppContext) {
+        let window = cx.add_window(|_, _| PaintScaleView);
+        let quads = cx
+            .update_window(window.into(), |_, window, cx| {
+                window.draw(cx).clear(cx);
+                (window.painted_quads(), window.scale_factor())
+            })
+            .unwrap();
+        let (quads, f) = quads;
+        assert_eq!(quads.len(), 5);
+        let rect = |q: &crate::Quad| {
+            [
+                q.bounds.origin.x.0 / f,
+                q.bounds.origin.y.0 / f,
+                q.bounds.size.width.0 / f,
+                q.bounds.size.height.0 / f,
+            ]
+        };
+        // Unscaled.
+        assert_eq!(rect(&quads[0]), [10., 20., 100., 50.]);
+        assert_eq!(quads[0].corner_radii.top_left.0 / f, 8.);
+        // Half size about (60, 45): the quad's own centre stays put.
+        assert_eq!(rect(&quads[1]), [35., 32.5, 50., 25.]);
+        assert_eq!(quads[1].corner_radii.top_left.0 / f, 4.);
+        assert_eq!(quads[1].border_widths.top.0 / f, 1.);
+        // Nested: .5 * .5 = .25, about the window origin after the outer transform: 2.5, 5, 25, 12.5
+        // composed with the outer scale: p' = .25 p + 60 * .5 * ... (see the algebra in with_paint_scale).
+        let inner = rect(&quads[2]);
+        assert_eq!(inner[2], 25.);
+        assert_eq!(inner[3], 12.5);
+        assert_eq!(inner[0], 10. * 0.25 + 30.);
+        assert_eq!(inner[1], 20. * 0.25 + 22.5);
