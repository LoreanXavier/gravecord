+impl Primitive {
+    /// A copy faded by `opacity` and, when `scale` is not 1, scaled about `origin` (device pixels). Used to
+    /// draw a layer that has just closed while its exit animation runs.
+    pub(crate) fn ghosted(
+        &self,
+        opacity: f32,
+        scale: f32,
+        origin: Point<ScaledPixels>,
+    ) -> Primitive {
+        let sb = |b: Bounds<ScaledPixels>| Bounds {
+            origin: Point::new(
+                ScaledPixels(origin.x.0 + (b.origin.x.0 - origin.x.0) * scale),
+                ScaledPixels(origin.y.0 + (b.origin.y.0 - origin.y.0) * scale),
+            ),
+            size: Size {
+                width: ScaledPixels(b.size.width.0 * scale),
+                height: ScaledPixels(b.size.height.0 * scale),
+            },
+        };
+        let sp = |p: Point<ScaledPixels>| {
+            Point::new(
+                ScaledPixels(origin.x.0 + (p.x.0 - origin.x.0) * scale),
+                ScaledPixels(origin.y.0 + (p.y.0 - origin.y.0) * scale),
+            )
+        };
+        let sv = |v: ScaledPixels| ScaledPixels(v.0 * scale);
+        let sc = |c: Corners<ScaledPixels>| Corners {
+            top_left: sv(c.top_left),
+            top_right: sv(c.top_right),
+            bottom_right: sv(c.bottom_right),
+            bottom_left: sv(c.bottom_left),
+        };
+        let sm = |m: ContentMask<ScaledPixels>| ContentMask {
+            bounds: sb(m.bounds),
+        };
+        match self {
+            Primitive::Quad(q) => Primitive::Quad(Quad {
+                bounds: sb(q.bounds),
+                content_mask: sm(q.content_mask),
+                background: q.background.opacity(opacity),
+                border_color: q.border_color.opacity(opacity),
+                corner_radii: sc(q.corner_radii),
+                border_widths: Edges {
+                    top: sv(q.border_widths.top),
+                    right: sv(q.border_widths.right),
+                    bottom: sv(q.border_widths.bottom),
+                    left: sv(q.border_widths.left),
+                },
+                ..*q
+            }),
+            Primitive::Shadow(s) => Primitive::Shadow(Shadow {
+                blur_radius: sv(s.blur_radius),
+                bounds: sb(s.bounds),
+                corner_radii: sc(s.corner_radii),
+                content_mask: sm(s.content_mask),
+                color: s.color.opacity(opacity),
+                element_bounds: sb(s.element_bounds),
+                element_corner_radii: sc(s.element_corner_radii),
+                ..*s
+            }),
+            Primitive::Underline(u) => Primitive::Underline(Underline {
+                bounds: sb(u.bounds),
+                content_mask: sm(u.content_mask),
+                color: u.color.opacity(opacity),
+                thickness: sv(u.thickness),
+                ..*u
+            }),
+            Primitive::MonochromeSprite(s) => Primitive::MonochromeSprite(MonochromeSprite {
+                bounds: sb(s.bounds),
+                content_mask: sm(s.content_mask),
+                color: s.color.opacity(opacity),
+                ..s.clone()
+            }),
+            Primitive::SubpixelSprite(s) => Primitive::SubpixelSprite(SubpixelSprite {
+                bounds: sb(s.bounds),
+                content_mask: sm(s.content_mask),
+                color: s.color.opacity(opacity),
+                ..s.clone()
+            }),
+            Primitive::PolychromeSprite(s) => Primitive::PolychromeSprite(PolychromeSprite {
+                bounds: sb(s.bounds),
+                content_mask: sm(s.content_mask),
+                corner_radii: sc(s.corner_radii),
+                opacity: s.opacity * opacity,
+                ..s.clone()
+            }),
+            Primitive::Path(p) => {
+                let mut p = p.clone();
+                p.bounds = sb(p.bounds);
+                p.content_mask = sm(p.content_mask);
+                p.color = p.color.opacity(opacity);
+                for vertex in &mut p.vertices {
+                    vertex.xy_position = sp(vertex.xy_position);
+                    vertex.content_mask = sm(vertex.content_mask);
+                }
+                Primitive::Path(p)
+            }
+            Primitive::Surface(s) => Primitive::Surface(s.clone()),
+        }
+    }
