+    struct PaintScaleView;
+
+    impl Render for PaintScaleView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            crate::canvas(
+                |_, _, _| {},
+                |_, _, window, _| {
+                    let quad = |window: &mut Window| {
+                        window.paint_quad(crate::PaintQuad {
+                            bounds: Bounds::new(point(px(10.), px(20.)), size(px(100.), px(50.))),
+                            corner_radii: crate::Corners::all(px(8.)),
+                            background: crate::hsla(0., 0., 1., 1.).into(),
+                            border_widths: crate::Edges::all(px(2.)),
+                            border_color: crate::hsla(0., 0., 0., 1.).into(),
+                            border_style: crate::BorderStyle::Solid,
+                        });
+                    };
+                    quad(window);
+                    // Half size about the centre of the quad (60, 45).
+                    window.with_paint_scale(0.5, point(px(60.), px(45.)), |window| {
+                        quad(window);
+                        // Nested scopes compose: a further .5 about the window origin.
+                        window.with_paint_scale(0.5, point(px(0.), px(0.)), |window| quad(window));
+                        // A content mask inside the scope is scaled with it.
+                        window.with_content_mask(
+                            Some(ContentMask {
+                                bounds: Bounds::new(
+                                    point(px(10.), px(20.)),
+                                    size(px(40.), px(50.)),
+                                ),
+                            }),
+                            quad,
+                        );
+                    });
+                    // Scale 1 is no scope at all, and the stack is empty again afterwards.
+                    window.with_paint_scale(1., point(px(0.), px(0.)), quad);
+                    assert!(window.paint_scale_stack.is_empty());
+                },
+            )
+            .size_full()
+        }
+    }
