+        // 32.5, 50, 25) intersect it.
+        let mask = quads[3].content_mask.bounds;
+        assert_eq!(
+            [
+                mask.origin.x.0 / f,
+                mask.origin.y.0 / f,
+                mask.size.width.0 / f,
+                mask.size.height.0 / f
+            ],
+            [35., 32.5, 20., 25.]
+        );
+        assert_eq!(rect(&quads[4]), [10., 20., 100., 50.]);
