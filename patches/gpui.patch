+/// What a deferred layer painted, kept to draw it again while it leaves; see [`Window::snapshot_layer`].
+pub struct LayerSnapshot {
+    operations: Vec<crate::scene::PaintOperation>,
+}
+
+impl LayerSnapshot {
+    #[doc(hidden)]
+    pub fn describe(&self) -> String {
+        let mut out = String::new();
+        for operation in &self.operations {
+            match operation {
+                crate::scene::PaintOperation::Primitive(p) => {
+                    let kind = match p {
+                        crate::scene::Primitive::Quad(_) => "quad",
+                        crate::scene::Primitive::Shadow(_) => "shadow",
+                        crate::scene::Primitive::BackdropBlur(_) => "backdrop_blur",
+                        crate::scene::Primitive::Underline(_) => "underline",
+                        crate::scene::Primitive::MonochromeSprite(_) => "mono",
+                        crate::scene::Primitive::SubpixelSprite(_) => "subpixel",
+                        crate::scene::Primitive::PolychromeSprite(_) => "poly",
+                        crate::scene::Primitive::Path(_) => "path",
+                        crate::scene::Primitive::Surface(_) => "surface",
+                    };
+                    let b = p.bounds();
+                    out.push_str(&format!(
+                        "{kind}({},{},{},{}) ",
+                        b.origin.x.0, b.origin.y.0, b.size.width.0, b.size.height.0
+                    ));
+                }
+                crate::scene::PaintOperation::StartLayer(_) => out.push_str("[ "),
+                crate::scene::PaintOperation::EndLayer => out.push_str("] "),
+            }
+        }
+        out
+    }
+
+    /// Whether some primitive of the layer covers the whole window (a scrim), and the bounds, in window pixels,
+    /// of the union of the primitives that do not (the dialog on it).
+    pub fn scrim_and_content(&self, window: &Window) -> (bool, Option<Bounds<Pixels>>) {
+        let factor = window.scale_factor();
+        let viewport = window.viewport_size().scale(factor);
+        let mut scrim = false;
+        let mut content: Option<Bounds<ScaledPixels>> = None;
+        for operation in &self.operations {
+            if let crate::scene::PaintOperation::Primitive(primitive) = operation {
+                let bounds = *primitive.bounds();
+                if bounds.size.width >= viewport.width && bounds.size.height >= viewport.height {
+                    scrim = true;
+                } else {
+                    content = Some(content.map_or(bounds, |c| c.union(&bounds)));
+                }
+            }
+        }
+        let content = content.map(|b| Bounds {
+            origin: point(Pixels(b.origin.x.0 / factor), Pixels(b.origin.y.0 / factor)),
+            size: size(
+                Pixels(b.size.width.0 / factor),
+                Pixels(b.size.height.0 / factor),
+            ),
+        });
+        (scrim, content)
+    }
+}
