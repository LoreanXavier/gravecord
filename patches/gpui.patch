+/// Inert mode (the harness crawler): effects on the outside world are skipped and noted instead.
+pub static INERT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Where a skipped effect is reported.
+pub static INERT_NOTE: std::sync::OnceLock<fn(&str)> = std::sync::OnceLock::new();
+
+thread_local! {
+    static TEXT_LOG: std::cell::RefCell<Vec<(Bounds<Pixels>, SharedString)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Inert mode only: records one painted line of text and where it went (the harness crawler names controls by it).
+pub(crate) fn inert_text(origin: Point<Pixels>, width: Pixels, height: Pixels, text: &SharedString) {
+    if INERT.load(std::sync::atomic::Ordering::Relaxed) && !text.is_empty() {
+        TEXT_LOG.with(|log| {
+            log.borrow_mut()
+                .push((Bounds::new(origin, crate::size(width, height)), text.clone()))
+        });
+    }
+}
+
+/// Empties the painted-text log.
+pub fn inert_text_clear() {
+    TEXT_LOG.with(|log| log.borrow_mut().clear());
+}
+
+/// The text painted since the log was last emptied.
+pub fn inert_text_log() -> Vec<(Bounds<Pixels>, SharedString)> {
+    TEXT_LOG.with(|log| log.borrow().clone())
+}
+
+/// True (after noting `what`) when inert mode is on and the effect must not happen.
+pub fn inert_skip(what: &str) -> bool {
+    if !INERT.load(std::sync::atomic::Ordering::Relaxed) {
+        return false;
+    }
+    if let Some(note) = INERT_NOTE.get() {
+        note(what);
+    }
+    true
+}
