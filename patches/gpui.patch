+    /// Zooms the whole interface like a browser's page zoom: layout runs in a viewport of
+    /// `content_size / zoom` logical pixels that is painted `zoom` times larger.
+    pub fn set_ui_zoom(&mut self, zoom: f32, cx: &mut App) {
