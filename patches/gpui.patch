+/// One of Chromium's panning cursors, which Blink shows during middle-button autoscroll and which Chromium loads on
+/// Windows from its own resources (`ui/resources/cursors/pan_*.cur`), copied here pixel for pixel: 32 x 32, hot spot
+/// at 16,16, rows top first, `.` transparent and any other symbol the `palette` entry (ARGB, straight alpha) at that
+/// symbol's place in `PAN_SYMBOLS`.
+struct PanCursor {
+    palette: &'static [u32],
+    rows: [&'static str; 32],
+}
+
+const PAN_SYMBOLS: &str = "#ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+/// The cursor as `CreateIconFromResourceEx` reads a cursor resource: the hot spot, then a 32-bit DIB whose height
+/// counts the colour image and the AND mask, both bottom row first.
+fn pan_cursor_resource(cursor: &PanCursor) -> Vec<u8> {
+    const SIZE: u32 = 32;
+    let mut bytes = Vec::with_capacity(4 + 40 + 4 * 32 * 32 + 4 * 32);
+    bytes.extend_from_slice(&16u16.to_le_bytes());
+    bytes.extend_from_slice(&16u16.to_le_bytes());
+    for field in [40, SIZE, SIZE * 2] {
+        bytes.extend_from_slice(&field.to_le_bytes());
+    }
+    bytes.extend_from_slice(&1u16.to_le_bytes());
+    bytes.extend_from_slice(&32u16.to_le_bytes());
+    for field in [0u32, 4 * SIZE * SIZE + 4 * SIZE, 0, 0, 0, 0] {
+        bytes.extend_from_slice(&field.to_le_bytes());
+    }
+    for row in cursor.rows.iter().rev() {
+        for symbol in row.chars() {
+            let argb = PAN_SYMBOLS
+                .find(symbol)
+                .and_then(|index| cursor.palette.get(index))
+                .copied()
+                .unwrap_or(0);
+            let [a, r, g, b] = argb.to_be_bytes();
+            bytes.extend_from_slice(&[b, g, r, a]);
+        }
+    }
+    for row in cursor.rows.iter().rev() {
+        let mut mask = 0u32;
+        for (column, symbol) in row.chars().enumerate() {
+            if symbol == '.' {
+                mask |= 1 << (31 - column);
+            }
+        }
+        bytes.extend_from_slice(&mask.to_be_bytes());
+    }
+    bytes
+}
+
+fn load_pan_cursor(lock: &OnceLock<SafeCursor>, cursor: &PanCursor) -> Option<HCURSOR> {
+    Some(
+        *(*lock.get_or_init(|| {
+            // Version 0x00030000 is the one every resource since Windows 3 uses; 0 x 0 with LR_DEFAULTSIZE takes the
+            // system cursor size, as Chromium's `LoadCursor` of the same resource does.
+            let resource = pan_cursor_resource(cursor);
+            HCURSOR(
+                unsafe {
+                    CreateIconFromResourceEx(&resource, false, 0x0003_0000, 0, 0, LR_DEFAULTSIZE)
+                }
+                .log_err()
+                .unwrap_or_default()
+                .0,
+            )
+            .into()
+        })),
+    )
+}
