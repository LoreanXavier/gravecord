+    /// The pointing-hand hitboxes of the last rendered frame that the pointer can reach at their centre: each is
+    /// `(bounds, id)`. Used by the harness crawler.
+    pub fn pointer_hitboxes(&self) -> Vec<(Bounds<Pixels>, u64)> {
+        let frame = &self.rendered_frame;
+        let mut seen = std::collections::HashSet::new();
+        let mut found = Vec::new();
+        for request in &frame.cursor_styles {
+            let (Some(id), CursorStyle::PointingHand) = (request.hitbox_id, request.style) else {
+                continue;
+            };
+            if !seen.insert(id) {
+                continue;
+            }
+            let Some(hitbox) = frame.hitboxes.iter().find(|hitbox| hitbox.id == id) else {
+                continue;
+            };
+            let bounds = hitbox.bounds.intersect(&hitbox.content_mask.bounds);
+            if bounds.size.width <= px(0.) || bounds.size.height <= px(0.) {
+                continue;
+            }
+            let centre = bounds.center();
+            let hit = frame.hit_test(centre);
+            // Reachable: no other hitbox that sets a cursor sits above it at its centre.
+            let top = hit
+                .ids
+                .iter()
+                .take(hit.hover_hitbox_count)
+                .find(|candidate| {
+                    frame
+                        .cursor_styles
+                        .iter()
+                        .any(|request| request.hitbox_id == Some(**candidate))
+                });
+            if top == Some(&id) {
+                found.push((bounds, id.0));
+            }
+        }
+        found
+    }
+
+    /// The solid fills painted in the last frame that cover at least `share` of `bounds` (and lie inside it, give or take
+    /// a pixel), as `(alpha, area share)`. The harness crawler tells a selected row (already filled) from a plain one.
+    pub fn quad_fills(&self, bounds: Bounds<Pixels>, share: f32) -> Vec<f32> {
+        let scale = self.scale_factor();
+        let area = (bounds.size.width.0 * bounds.size.height.0).max(1.);
+        let mut found = Vec::new();
+        for quad in &self.rendered_frame.scene.quads {
+            let Some(fill) = quad.background.as_solid() else {
+                continue;
+            };
+            if fill.a <= 0. {
+                continue;
+            }
+            let at = quad.bounds.map(|value| value.0 / scale);
+            let inter = bounds.intersect(&Bounds::new(
+                point(px(at.origin.x), px(at.origin.y)),
+                size(px(at.size.width), px(at.size.height)),
+            ));
+            let covered = inter.size.width.0.max(0.) * inter.size.height.0.max(0.);
+            let quad_area = (at.size.width * at.size.height).max(1.);
+            // The quad is the element's own (it does not spill far outside) and covers most of it.
+            if covered / area >= share && covered / quad_area >= 0.5 {
+                found.push(fill.a);
+            }
+        }
+        found
+    }
+
+    /// Whether any glyph centred in `bounds` in the last frame is actually seen: inside its clip and not under a later
+    /// opaque fill. The harness crawler uses it to leave out text that a settings page or a menu covers.
+    pub fn text_visible(&self, bounds: Bounds<Pixels>) -> bool {
+        let scale = self.scale_factor();
+        let scene = &self.rendered_frame.scene;
+        let area = bounds.map(|value| ScaledPixels(value.0 * scale));
+        let sprites = scene
+            .monochrome_sprites
+            .iter()
+            .map(|sprite| (sprite.order, sprite.bounds, sprite.content_mask.bounds))
+            .chain(
+                scene
+                    .subpixel_sprites
+                    .iter()
+                    .map(|sprite| (sprite.order, sprite.bounds, sprite.content_mask.bounds)),
+            );
+        for (order, at, mask) in sprites {
+            let centre = at.center();
+            if !area.contains(&centre) || !mask.contains(&centre) {
+                continue;
+            }
+            let covered = scene.quads.iter().any(|quad| {
+                quad.order > order
+                    && quad
+                        .background
+                        .as_solid()
+                        .is_some_and(|fill| fill.a >= 0.95)
+                    && quad.bounds.contains(&centre)
+                    && quad.content_mask.bounds.contains(&centre)
+            });
+            if !covered {
+                return true;
+            }
+        }
+        false
+    }
