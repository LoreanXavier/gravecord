+    use std::sync::atomic::Ordering::Relaxed;
+    DRAW_PHASE_NS[0].fetch_add((layout - start).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[1].fetch_add((prepaint - layout).as_nanos() as u64, Relaxed);
+    DRAW_PHASE_NS[2].fetch_add((end - prepaint).as_nanos() as u64, Relaxed);
