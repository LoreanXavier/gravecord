diff --git a/crates/gpui/src/text_system/line.rs b/crates/gpui/src/text_system/line.rs
index 5691782..737dc7a 100644
--- a/crates/gpui/src/text_system/line.rs
+++ b/crates/gpui/src/text_system/line.rs
@@ -545,8 +545,12 @@ fn paint_line(
         wrap_boundaries,
     );
     window.paint_layer(line_bounds, |window| {
-        let padding_top = (line_height - layout.ascent - layout.descent) / 2.;
-        let baseline_offset = point(px(0.), padding_top + layout.ascent);
+        // gravecord: Chromium's rule. It rounds ascent and descent separately and floors the half-leading,
+        // so text sits on the same pixel row as the official client.
+        let rounded_ascent = layout.ascent.round();
+        let rounded_descent = layout.descent.round();
+        let padding_top = ((line_height - rounded_ascent - rounded_descent) / 2.).floor();
+        let baseline_offset = point(px(0.), padding_top + rounded_ascent);
         let underline_y_offset = underline_y_offset(line_height, layout.ascent, layout.descent);
         let mut decoration_runs = decoration_runs.iter();
         let mut wraps = wrap_boundaries.iter().peekable();
