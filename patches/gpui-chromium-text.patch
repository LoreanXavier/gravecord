+/// gravecord: lets the text calibration override what the system reports.
+fn text_setting(name: &str, system: f32) -> f32 {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(system)
+}
